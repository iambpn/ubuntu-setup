#!/bin/bash

# git worktree add reports an all-zero previous HEAD. Regular branch and file
# checkouts must not refill an intentionally removed .env file.
previous_head=${1:-}
if [[ -z $previous_head || -n ${previous_head//0/} || ${3:-} != 1 ]]; then
	exit 0
fi

common_git_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || exit 0
is_bare_repository=$(git --git-dir="$common_git_dir" rev-parse --is-bare-repository 2>/dev/null)
hook_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 0

bash "$hook_dir/post-checkout.d/copy-env.sh" "$common_git_dir" "$is_bare_repository"
