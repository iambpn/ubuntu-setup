
# Copied to ~/.proto/.prototools (proto's global config) by install/proto.sh.
# proto rewrites that file as tools are installed, so it's a copy, not a
# symlink. Edit this only to change the starting point for a fresh machine.

npm = "bundled"

# enable bundled npm to be used with node
[tools.node]
bundled-npm = true

# allow shared global dirs between different versions
# might need to add '/home/acer/.proto/tools/node/globals/bin' to the PATH
[tools.npm]
shared-globals-dir = true

[settings]
auto-install = true
telemetry = false
